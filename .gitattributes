# Normalize all text files to LF in the repo
* text=auto eol=lf

# Force specific files to LF
*.sh text eol=lf

# Force specific files to CRLF (e.g. Windows batch scripts)
*.bat text eol=crlf

# Treat as binary (no conversion)
*.png binary

